{
  "name": "genroc-tests",
  "type": "module",
  "scripts": {
    "test": "vitest run --project='!stress' && vitest run --project=stress",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../openapi.json -o generated/api.ts",
    "playground:generate": "node playground/codegen.ts",
    "playground:scripts": "node ../evaluator/server.ts",
    "playground:run": "node playground/run.ts",
    "bench-recursive": "node bench/run.ts recursive",
    "bench-deep": "node bench/run.ts deep",
    "bench-drain": "node bench/run.ts drain",
    "bench-drain-big": "node bench/run.ts drain_big"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.0",
    "js-yaml": "^5.2.1",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
