{
  "process": "weather-logger",
  "process_input": {
    "$ref": "#/$defs/input"
  },
  "process_output": {
    "$ref": "#/$defs/output"
  },
  "tasks": {
    "geocode": {
      "action_type": "fetch",
      "input": {
        "type": "object"
      },
      "output": {
        "$ref": "#/$defs/geocode_output"
      }
    },
    "reading": {
      "action_type": "child",
      "input": {
        "$ref": "#/$defs/reading_input"
      },
      "output": {
        "$ref": "#/$defs/reading_output"
      }
    }
  },
  "$defs": {
    "geocode_output": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "null",
            "string"
          ]
        },
        "lat": {
          "type": [
            "null",
            "number"
          ]
        },
        "lon": {
          "type": [
            "null",
            "number"
          ]
        }
      },
      "required": [
        "label",
        "lat",
        "lon"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "place": {
          "type": "string",
          "default": "Praha"
        },
        "script_url": {
          "type": "string",
          "default": "http://localhost:3010"
        },
        "ticks": {
          "type": "integer",
          "description": "kolik mereni udelat; 0 = bezet donekonecna",
          "default": 0
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string"
        },
        "place": {
          "type": [
            "null",
            "string"
          ]
        },
        "readings": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "temperature_c": {
          "type": "number"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "condition",
        "place",
        "readings",
        "summary",
        "temperature_c",
        "time"
      ]
    },
    "reading_input": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "geo": {
              "$ref": "#/$defs/geocode_output"
            }
          },
          "required": [
            "geo"
          ]
        },
        "runner_url": {
          "type": "string",
          "default": "http://localhost:3010"
        },
        "timeout_ms": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "input",
        "runner_url",
        "timeout_ms"
      ]
    },
    "reading_output": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "temperature_c": {
          "type": "number"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "condition",
        "count",
        "summary",
        "temperature_c",
        "time"
      ]
    }
  }
}
