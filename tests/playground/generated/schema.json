{
  "process": "weather-logger",
  "process_input": {
    "$ref": "#/$defs/input"
  },
  "tasks": {
    "location": {
      "action_type": "child",
      "input": {
        "$ref": "#/$defs/location_input"
      },
      "result": {
        "$ref": "#/$defs/geo_response"
      },
      "output": {
        "$ref": "#/$defs/location_output"
      }
    },
    "reading": {
      "action_type": "child",
      "input": {
        "$ref": "#/$defs/reading_input"
      },
      "result": {
        "$ref": "#/$defs/reading"
      },
      "output": {
        "$ref": "#/$defs/reading_output"
      }
    },
    "wait": {
      "action_type": "delay",
      "input": {
        "type": "object"
      },
      "result": {
        "type": "null"
      },
      "last_error": {
        "oneOf": [
          {
            "$ref": "#/$defs/script_throw"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "$defs": {
    "geo_response": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "name"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "place": {
          "type": "string",
          "default": "Praha"
        }
      }
    },
    "location_input": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "place": {
              "type": "string",
              "default": "Praha"
            }
          },
          "required": [
            "place"
          ]
        }
      },
      "required": [
        "code",
        "input"
      ]
    },
    "location_output": {
      "$ref": "#/$defs/geo_response"
    },
    "reading": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "temperature_c": {
          "type": "number"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "time",
        "condition",
        "temperature_c",
        "summary"
      ]
    },
    "reading_input": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "geo": {
              "$ref": "#/$defs/location_output"
            }
          },
          "required": [
            "geo"
          ]
        },
        "timeout_ms": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "input",
        "timeout_ms"
      ]
    },
    "reading_output": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "last": {
          "$ref": "#/$defs/reading"
        }
      },
      "required": [
        "count",
        "last"
      ]
    },
    "script_throw": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "stack": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "stack"
      ]
    }
  }
}
