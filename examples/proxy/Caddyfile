# The router in front of genroc. specs/api-auth.md §1, §5.1.
#
# Caddy does no authentication of its own here — it asks oauth2-proxy, which runs the OIDC
# flow against Dex. Caddy's job is the part that has to be right: deciding which zone a path
# belongs to, and making sure the identity headers genroc trusts can only have come from
# oauth2-proxy.

# Stripping is LOAD-BEARING, not tidiness. genroc believes these headers because they arrive
# from this proxy's address, so forwarding a CLIENT's copy launders a forgery into a trusted
# assertion. Measured before this existed: an unauthenticated caller setting
# `X-Auth-Request-Email` on PUT /api/definitions got 200 and wrote a definition as an admin.
#
# A snippet must be defined at the TOP LEVEL — inside a site block the import does not
# resolve, and `caddy validate` is what says so.
(strip_identity) {
	header_up -X-Auth-Request-User
	header_up -X-Auth-Request-Email
	header_up -X-Auth-Request-Groups
}

# The request-side twin of (strip_identity). forward_auth writes onto the REQUEST, so the
# browser zone clears the request's own copies rather than the ones being proxied out.
# Defined here rather than below because a snippet must appear BEFORE the import that uses it.
(strip_identity_req) {
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
}

:8080 {
	# ── the machine zone: NOT behind the login ───────────────────────────────────────────
	# A client presenting a bearer token must never meet a redirect to a login page. §5.1.
	# These routes pass through untouched EXCEPT for the strip, which is the whole reason
	# they cannot simply be `reverse_proxy genroc:8448`.
	handle /api/* {
		reverse_proxy genroc:8448 {
			import strip_identity
		}
	}
	handle /healthz {
		reverse_proxy genroc:8448 {
			import strip_identity
		}
	}
	handle /public/* {
		reverse_proxy genroc:8448 {
			import strip_identity
		}
	}

	# ── the login flow itself ────────────────────────────────────────────────────────────
	# /oauth2/start, /oauth2/callback, /oauth2/sign_out. Must be reachable unauthenticated,
	# or there is no way to become authenticated.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# ── the browser zone: the UI and the session exchange ────────────────────────────────
	# `route` rather than `handle` because Caddy sorts directives by type and this sequence
	# must run in the order written: strip what the client sent, THEN let forward_auth write
	# what oauth2-proxy vouched for. Sorted, the strip could run after the set and erase it.
	handle {
		route {
			import strip_identity_req

			# Asks oauth2-proxy "is this session valid?" — 202 with the identity headers, or
			# 401. copy_headers puts them on the request going upstream, overwriting whatever
			# survived the strip.
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups

				@unauthorized status 401
				handle_response @unauthorized {
					# rd is RELATIVE on purpose. `{host}` drops the port, so an absolute
					# `{scheme}://{host}{uri}` sends the browser to localhost:80 after login —
					# and the failure is a dead redirect at the END of a successful login,
					# which reads as the login being broken.
					redir * /oauth2/start?rd={uri}
				}
			}
			reverse_proxy genroc:8448
		}
	}
}
