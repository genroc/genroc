# The router in front of genroc. specs/auth-two-credentials.md §3.
#
# Caddy does no authentication of its own — it asks oauth2-proxy, which runs the OIDC flow
# against Dex and hands back the ID token. Caddy's job is deciding which of two ways in a
# request takes, and that decision is made on ONE thing: whether it already carries a credential.
#
# There is no header to strip any more. genroc reads no identity headers at all, so a client
# setting `X-Auth-Request-Email` is setting a header nothing looks at — which is the point of
# moving to a signature (specs/auth-two-credentials.md §1).

# 8448 is genroc's own default port, so `genctl` needs no --server and the URL you open is the
# one you would use without a proxy. The proxy stands exactly where genroc would.
:8448 {
	# A request that already carries a credential — a `genroc_sk_*` from a machine, or a JWT
	# from anything that obtained one itself. Named matchers are scoped to a site block and
	# cannot be defined above it; `caddy validate` is what says so.
	@credentialed header Authorization *

	# ── unauthenticated by design ────────────────────────────────────────────────────────
	# A probe must answer before any identity exists, and the docs disclose nothing stored.
	handle /healthz {
		reverse_proxy genroc:8448
	}
	handle /public/* {
		reverse_proxy genroc:8448
	}

	# ── the login flow itself ────────────────────────────────────────────────────────────
	# Must be reachable unauthenticated, or there is no way to become authenticated.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# ── the API: two ways in, chosen by credential presence ──────────────────────────────
	# A caller holding a credential goes STRAIGHT to genroc. That bypasses the proxy, and it
	# costs nothing: the proxy was never the security boundary on this branch, genroc validates
	# the credential itself, and a junk value gets a 401 rather than a redirect. What it buys is
	# that a script never receives an HTML login page instead of JSON.
	#
	# Everything else is a browser holding a session cookie. forward_auth turns that cookie into
	# `Authorization: Bearer <ID token>`, which genroc verifies like any other JWT.
	handle /api/* {
		route {
			reverse_proxy @credentialed genroc:8448

			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				# oauth2-proxy sets this from the ID token (--set-authorization-header).
				copy_headers Authorization

				# An XHR must not be answered with a login redirect: the SPA cannot follow one
				# cross-origin and would render the login page as a failed API call. 401 lets
				# the app decide, which for a full page load is a reload into the flow below.
				@unauthorized status 401
				handle_response @unauthorized {
					respond 401
				}
			}
			reverse_proxy genroc:8448
		}
	}

	# ── the browser zone: the UI ─────────────────────────────────────────────────────────
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers Authorization

			@unauthorized status 401
			handle_response @unauthorized {
				# rd is RELATIVE on purpose. `{host}` drops the port, so an absolute
				# `{scheme}://{host}{uri}` sends the browser to localhost:80 after login — and
				# the failure is a dead redirect at the END of a successful login, which reads
				# as the login being broken.
				redir * /oauth2/start?rd={uri}
			}
		}
		reverse_proxy genroc:8448
	}
}
