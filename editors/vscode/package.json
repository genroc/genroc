{
  "name": "genroc",
  "displayName": "genroc",
  "description": "Diagnostics, hover, completion and navigation for genroc process definitions.",
  "version": "0.0.0",
  "publisher": "genroc",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genroc/genroc.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://genroc.org",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/*.genroc.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "genroc",
        "aliases": [
          "genroc"
        ],
        "filenamePatterns": [
          "**/*.genroc.yaml",
          "**/*.genroc.yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "genroc",
        "scopeName": "source.genroc",
        "path": "./syntaxes/genroc.tmLanguage.json"
      },
      {
        "scopeName": "source.genroc.slots",
        "path": "./syntaxes/genroc-slots.tmLanguage.json",
        "injectTo": [
          "source.genroc"
        ]
      }
    ],
    "configuration": {
      "title": "genroc",
      "properties": {
        "genroc.server.path": {
          "type": "string",
          "default": "genctl",
          "description": "Path to the genctl binary. The language server is `genctl lsp`."
        },
        "genroc.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the genroc language server for *.genroc.yaml files."
        },
        "genroc.server.bundled": {
          "type": "boolean",
          "default": true,
          "description": "Fall back to the genctl bundled with this extension (WebAssembly) when there is none on PATH. Slower than the binary, and it carries the version the extension shipped with."
        }
      }
    },
    "configurationDefaults": {
      "[genroc]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.suggest.showWords": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "package": "npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
