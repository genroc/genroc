---
import { getCollection, render } from 'astro:content'
import Doc from '../layouts/Doc.astro'
import Screenshot from '../components/Screenshot.astro'
import { hrefFor } from '../lib/nav'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
// A folder page carries no body: it exists to name and place its folder, so anyone who reaches
// its URL belongs on its first child.
if (!entry.body?.trim()) {
  const target = await hrefFor(entry.id)
  if (target) return Astro.redirect(target)
}
const { Content, headings } = await render(entry)
---

<Doc title={entry.data.title} description={entry.data.description ?? ''} slug={entry.id} headings={headings}>
  <Content components={{ Screenshot }} />
</Doc>
