---
import { getCollection, render } from 'astro:content'
import Doc from '../layouts/Doc.astro'
import Screenshot from '../components/Screenshot.astro'
import { hrefFor } from '../lib/nav'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
// A folder page carries no body: it names and places its folder. Nothing on the site links
// here -- every link resolves to the child instead (src/lib/nav.ts) -- so this catches only a
// hand-typed URL. Not `Astro.redirect`: its static form is a visible 2-second meta refresh.
if (!entry.body?.trim()) {
  const target = await hrefFor(entry.id)
  if (target)
    return new Response(
      `<!doctype html><meta http-equiv="refresh" content="0;url=${target}"><meta name="robots" content="noindex">`,
      { headers: { 'content-type': 'text/html' } },
    )
}
const { Content, headings } = await render(entry)
---

<Doc title={entry.data.title} description={entry.data.description ?? ''} slug={entry.id} headings={headings}>
  <Content components={{ Screenshot }} />
</Doc>
