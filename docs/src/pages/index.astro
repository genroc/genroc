---
import Base from '../layouts/Base.astro'
import Logo from '../components/Logo.astro'
import Transcript from '../components/transcript/Transcript.astro'
import type { TranscriptLine } from '../components/transcript/Transcript.astro'
import { navSections } from '../lib/nav'
import { url } from '../lib/url'

const sections = await navSections()

const session: TranscriptLine[] = [
  { kind: 'cmd', text: 'genctl apply -f greet.genroc.yaml' },
  { kind: 'out', text: 'greet: version 1 applied' },
  { kind: 'cmd', text: 'genctl run greet --set url=https://api.example.com --set name=World' },
  { kind: 'out', text: 'instance 01JBQ… started' },
  { kind: 'cmd', text: 'genctl get @last' },
  { kind: 'out', text: 'status: completed   output: {"ok": true}' },
]
---

<Base
  title="genroc — documentation"
  description="Documentation for genroc, a durable process orchestrator: guides and a reference for the definition language, the HTTP API and genctl."
>
  <div class="home">
    <div class="hero">
      <Logo size="6rem" />
      <pre class="banner" aria-label="genroc">
█████ █████ █   █ ████  █████ █████
█     █     ██  █ █   █ █   █ █
█ ███ ████  █ █ █ ████  █   █ █
█   █ █     █  ██ █  █  █   █ █
█████ █████ █   █ █   █ █████ █████</pre>
    </div>

    <p class="tagline">
      A durable process orchestrator. Describe a process as tasks in YAML; genroc runs each
      instance to completion — surviving worker crashes, restarts and long waits
      <span class="muted">without holding a thread or losing state.</span>
    </p>

    <Transcript lines={session} />

    {
      sections.map((s) => (
        <section>
          <h2 style="margin-top:2.5rem">{s.label}</h2>
          <p class="muted" style="color:var(--muted);margin:0">{s.blurb}</p>
          <div class="cards">
            {s.entries.map((e) => (
              <a class="card" href={url(e.slug)}>
                <strong>{e.title}</strong>
                <p>{e.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
