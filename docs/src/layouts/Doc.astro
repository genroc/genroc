---
import type { MarkdownHeading } from 'astro'
import Base from './Base.astro'
import Sidebar from '../components/Sidebar.astro'
import Toc from '../components/Toc.astro'
import { url } from '../lib/url'

interface Props {
  title: string
  description: string
  section: string
  slug: string
  headings: MarkdownHeading[]
}

const { title, description, section, slug, headings } = Astro.props
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3)
---

<Base title={`${title} — genroc`} description={description}>
  <details class="nav-drawer">
    <summary>navigation</summary>
    <Sidebar current={slug} />
  </details>
  <div class={`shell${hasToc ? '' : ' no-toc'}`}>
    <Sidebar current={slug} />
    <main>
      <div class="prose">
        <div class="page-head">
          <p class="crumb">
            <a href={url('/')}>docs</a> / {section}
          </p>
          <h1>{title}</h1>
          <p>{description}</p>
        </div>
        <slot />
      </div>
    </main>
    <Toc headings={headings} />
  </div>
</Base>
