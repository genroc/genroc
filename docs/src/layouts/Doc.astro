---
import type { MarkdownHeading } from 'astro'
import Base from './Base.astro'
import Sidebar from '../components/Sidebar.astro'
import Toc from '../components/Toc.astro'
import { crumbs, neighbours } from '../lib/nav'
import { url } from '../lib/url'

interface Props {
  title: string
  description: string
  slug: string
  headings: MarkdownHeading[]
}

const { title, description, slug, headings } = Astro.props
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3)
const trail = await crumbs(slug)
const { prev, next } = await neighbours(slug)
---

<Base title={`${title} — genroc`} description={description}>
  <details class="nav-drawer">
    <summary>navigation</summary>
    <Sidebar current={slug} />
  </details>
  <div class={`shell${hasToc ? '' : ' no-toc'}`}>
    <Sidebar current={slug} />
    {/* Runs before first paint so the view transition's incoming snapshot is already scrolled.
        Recentering on every load would jump the menu under a click, so the previous scroll is
        kept while the current item stays in view. */}
    <script is:inline>
      ;(function () {
        const side = document.querySelector('.shell > .sidebar')
        const cur = side && side.querySelector('a[aria-current="page"]')
        if (!side || !cur || !side.clientHeight) return
        try {
          side.scrollTop = Number(sessionStorage.getItem('sidebar-scroll')) || 0
        } catch (_) {}
        const s = side.getBoundingClientRect()
        const c = cur.getBoundingClientRect()
        if (c.top < s.top || c.bottom > s.bottom) {
          side.scrollTop += c.top - s.top - (side.clientHeight - c.height) / 2
        }
        addEventListener('pagehide', function () {
          try {
            sessionStorage.setItem('sidebar-scroll', String(side.scrollTop))
          } catch (_) {}
        })
      })()
    </script>
    <main>
      <div class="prose">
        <div class="page-head">
          <p class="crumb">
            <a href={url('/')}>docs</a>
            {trail.map((c) => <> / {c.href ? <a href={c.href}>{c.label}</a> : c.label}</>)}
          </p>
          <h1>{title}</h1>
          <p>{description}</p>
        </div>
        <slot />
        {
          (prev || next) && (
            <nav class="page-nav" aria-label="reading order">
              {prev && (
                <a class="prev" href={prev.href}>
                  <span>previous</span>
                  <strong>{prev.title}</strong>
                </a>
              )}
              {next && (
                <a class="next" href={next.href}>
                  <span>next</span>
                  <strong>{next.title}</strong>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </main>
    <Toc headings={headings} />
  </div>
</Base>
