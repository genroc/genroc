---
import Logo from './Logo.astro'
import Search from './Search.astro'
import { navSections } from '../lib/nav'
import { url } from '../lib/url'

const path = Astro.url.pathname
// A section link lands on its first page, so reordering the nav moves it too.
const links = (await navSections()).map((s) => ({ href: s.href, label: s.label, match: `/${s.id}/` }))
---

<header class="topbar">
  <a class="brand" href={url('/')}>
    <Logo size="1.5em" />
    <span>genroc</span>
  </a>
  <nav>
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={path.includes(l.match) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
  <Search />
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme">
    &#9681;
  </button>
</header>

<script is:inline>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches
    root.dataset.theme = dark ? 'light' : 'dark'
    localStorage.setItem('theme', root.dataset.theme)
  })
</script>
