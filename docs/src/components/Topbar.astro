---
import Logo from './Logo.astro'
import Search from './Search.astro'
import { navSections } from '../lib/nav'
import { url } from '../lib/url'

const path = Astro.url.pathname
// A section link lands on its first page, so reordering the nav moves it too.
const links = (await navSections()).map((s) => ({ href: s.href, label: s.label, match: `/${s.id}/` }))
---

<header class="topbar">
  <a class="brand" href={url('/')}>
    <Logo size="1.5em" />
    <span>genroc</span>
  </a>
  <nav>
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={path.includes(l.match) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
  <Search />
</header>
