---
import type { NavEntry } from '../lib/nav'

interface Props {
  entries: NavEntry[]
  current?: string
}

const { entries, current } = Astro.props

// Three states, not one. `trail` is "the page being read is in here" and colours the path to
// the reader; `open` is "children are rendered"; `collapsible` is "open is a state it can
// leave" — and only that one earns the +/- marker, which would otherwise promise a group can
// close when it never does. Decided per render, so the state is in the HTML, not a script.
const holds = (e: NavEntry): boolean => e.children.some((c) => c.slug === current || holds(c))
---

<ul>
  {
    entries.map((e) => {
      const group = e.children.length > 0
      const collapsible = group && e.autoCollapse
      const trail = group && holds(e)
      const open = group && (trail || !collapsible)
      return (
        <li class:list={[collapsible && 'collapsible', trail && 'trail', open && 'open']}>
          <a href={e.href} aria-current={e.slug === current ? 'page' : undefined}>
            {e.title}
          </a>
          {open && <Astro.self entries={e.children} current={current} />}
        </li>
      )
    })
  }
</ul>
