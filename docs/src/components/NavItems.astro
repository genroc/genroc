---
import type { NavEntry } from '../lib/nav'

interface Props {
  entries: NavEntry[]
  current?: string
}

const { entries, current } = Astro.props
---

<ul>
  {
    entries.map((e) => (
      <li>
        <a href={e.href} aria-current={e.slug === current ? 'page' : undefined}>
          {e.title}
        </a>
        {e.children.length > 0 && <Astro.self entries={e.children} current={current} />}
      </li>
    ))
  }
</ul>
