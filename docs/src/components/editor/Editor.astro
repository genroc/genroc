---
// The definition on the home page as the editor shows it: the completion open on an
// unfinished path, the diagnostic under it.
//
// Coloured here rather than by Shiki: the caret and the popup sit BETWEEN tokens, which
// highlighter output has nowhere to put. The classes are the scopes src/shiki-theme.ts uses.
import './editor.css'

export type Mark = { line: number; from: number; to: number; caret: number }
export type Completion = { label: string; type: string }
/** What `textDocument/hover` answers over the last segment of `symbol`, at its first
    occurrence on that line — pointing at `greet` asks about `outputs.greet`. */
export type Hover = { line: number; symbol: string; type: string }

interface Props {
  code: string
  mark: Mark
  completion: Completion[]
  hovers: Hover[]
}

const { code, mark, completion, hovers } = Astro.props

type Piece = { cls: string; text: string }

const TOKEN = new RegExp(
  [
    '(?<comment>#.*)',
    '(?<str>"(?:[^"\\\\]|\\\\.)*"?)',
    '(?<key>[\\w.-]+(?=\\s*:))',
    '(?<constant>\\b(?:true|false|null)\\b|\\d[\\w.]*)',
    '(?<plain>[A-Za-z_][\\w.-]*)',
    '(?<punct>[{}\\[\\],:-]+)',
  ].join('|'),
  'g',
)

// A string is one token to the grammar but not one colour: `${ }` and `$:` are the marks that
// say the value is computed, and what they wrap is a path, not text.
function stringPieces(text: string): Piece[] {
  const close = text.length > 1 && text.endsWith('"') ? '"' : ''
  const body = text.slice(1, text.length - close.length)
  const out: Piece[] = [{ cls: 'str', text: '"' }]
  let expr = false
  for (const part of body.split(/(\$\{|\}|\$:)/)) {
    if (!part) continue
    if (part === '}') expr = false
    else if (part === '${' || part === '$:') expr = true
    else {
      out.push({ cls: expr ? 'expr' : 'str', text: part })
      continue
    }
    out.push({ cls: 'marker', text: part })
  }
  if (close) out.push({ cls: 'str', text: close })
  return out
}

function tokenize(line: string): Piece[] {
  const out: Piece[] = []
  let at = 0
  for (const m of line.matchAll(TOKEN)) {
    if (m.index > at) out.push({ cls: 'plain', text: line.slice(at, m.index) })
    const cls = Object.keys(m.groups!).find((k) => m.groups![k] !== undefined)!
    if (cls === 'str') out.push(...stringPieces(m[0]))
    else out.push({ cls, text: m[0] })
    at = m.index + m[0].length
  }
  if (at < line.length) out.push({ cls: 'plain', text: line.slice(at) })
  return out
}

// Offsets ascending. No piece may straddle one, or the tag that opens there lands inside
// a token's span.
function cut(pieces: Piece[], offsets: number[]): Piece[] {
  const out: Piece[] = []
  let at = 0
  for (const piece of pieces) {
    let { text } = piece
    for (const offset of offsets) {
      const i = offset - at
      if (i <= 0 || i >= text.length) continue
      out.push({ cls: piece.cls, text: text.slice(0, i) })
      text = text.slice(i)
      at = offset
    }
    out.push({ cls: piece.cls, text })
    at += text.length
  }
  return out
}

const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

type Wrap = { from: number; to: number; open: string; close: string }

function wraps(text: string, line: number): Wrap[] {
  const out: Wrap[] = []
  if (line === mark.line) {
    out.push({ from: mark.from, to: mark.to, open: '<span class="squiggle">', close: '</span>' })
  }
  for (const hover of hovers.filter((h) => h.line === line)) {
    const at = text.indexOf(hover.symbol)
    if (at < 0) continue
    const from = at + hover.symbol.lastIndexOf('.') + 1
    out.push({
      from,
      to: at + hover.symbol.length,
      open: '<span class="hovered">',
      // The tip hangs off the ROW, not off the symbol, so it can be held inside the pane —
      // which is why it carries the column it belongs to.
      close:
        `<span class="tip" style="--col:${from}"><span class="sym">${escapeHtml(hover.symbol)}</span> \u2192 ` +
        `<span class="ty">${escapeHtml(hover.type)}</span></span></span>`,
    })
  }
  return out
}

function render(text: string, line: number): string {
  const ranges = wraps(text, line)
  const caret = line === mark.line ? mark.caret : -1
  const offsets = [...ranges.flatMap((r) => [r.from, r.to]), caret].filter((n) => n >= 0).sort((a, b) => a - b)
  let at = 0
  let html = ''
  // Closes before opens, so two ranges that touch still nest; none of these ranges overlap.
  const edges = (pos: number) => {
    for (const r of ranges) if (r.to === pos) html += r.close
    for (const r of ranges) if (r.from === pos) html += r.open
    if (pos === caret) html += '<span class="caret"></span>'
  }
  for (const piece of cut(tokenize(text), offsets)) {
    edges(at)
    html += `<span class="${piece.cls}">${escapeHtml(piece.text)}</span>`
    at += piece.text.length
  }
  edges(at)
  return html
}

const lines = code.split('\n')
const rows = lines.map((text, i) => ({
  html: render(text, i + 1),
  current: i + 1 === mark.line,
}))

// The gutter and the widest line, in characters: pane.css sizes the text from --cols so the
// pane fits a phone instead of scrolling, and the gutter is part of what has to fit.
const GUTTER = 4
const cols = GUTTER + Math.max(...lines.map((l) => l.length))
---

{/* Rows are blocks and only they are `pre`: whitespace between them is collapsible, which is
    what keeps the source's own indentation out of the rendering. */}
<div class="editor" style={`--gut:${GUTTER};--cols:${cols}`}>
  {
    rows.map((row) => <span class:list={['row', { current: row.current }]} set:html={row.html} />)
  }
  {/* Placed on the grid rather than nested in its row, which is written as one HTML string:
      every glyph is one `ch` wide and every line `--lh`, so a column and a line are enough. */}
  <div class="completion" style={`--line:${mark.line};--col:${mark.caret}`}>
    {
      completion.map((item, i) => (
        <div class:list={['item', { selected: i === 0 }]}>
          <span class="icon">◈</span>
          <span class="name">{item.label}</span>
          <span class="type">{item.type}</span>
        </div>
      ))
    }
  </div>
</div>
