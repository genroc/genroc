---
interface Props {
  src: string
}

const { src } = Astro.props

// Inlined rather than an <img>: the SVG colours itself from the page's CSS variables, which
// an <img> cannot see, so it would stay light-themed on a dark page.
const diagrams = import.meta.glob<string>('/src/assets/diagrams/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})
const svg = diagrams[`/src/assets/diagrams/${src}`]
if (!svg) {
  const known = Object.keys(diagrams).map((p) => p.split('/').pop()).sort()
  throw new Error(`no diagram "${src}" in src/assets/diagrams — have: ${known.join(', ')}`)
}
---

<figure class="diagram" set:html={svg} />

<style>
  .diagram {
    margin: 1.5rem 0;
  }

  .diagram :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
