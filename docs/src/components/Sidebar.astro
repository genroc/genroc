---
import NavItems from './NavItems.astro'
import { navSections } from '../lib/nav'

interface Props {
  current?: string
}

const { current } = Astro.props
const sections = await navSections()
---

<aside class="sidebar">
  {
    sections.map((s) => (
      <section>
        <h2>{s.label}</h2>
        <NavItems entries={s.entries} current={current} />
      </section>
    ))
  }
</aside>
