---
import { navSections } from '../lib/nav'
import { url } from '../lib/url'

interface Props {
  current?: string
}

const { current } = Astro.props
const sections = await navSections()
---

<aside class="sidebar">
  {
    sections.map((s) => (
      <section>
        <h2>{s.label}</h2>
        <ul>
          {s.entries.map((e) => (
            <li>
              <a href={url(e.slug)} aria-current={e.slug === current ? 'page' : undefined}>
                {e.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</aside>
